@@ -0,0 +1,289 @@
+"""The feedback chat (docs/sdlc/cycles/015-feedback-chat/spec.md): scripted questions, no AI, that say what a person thinks of the app.
+
+Three paths (an idea, a problem, an opinion), each a fixed list of five questions. The first is required, the others can be skipped. An answer is
+saved the moment it is given (`answer`), so a chat closed halfway is kept. What is stored in `Feedback.answers`, per question key:
+  - a text or the key of a choice;  - None when the person skipped it;  - {"quick": key} when they tapped a quick button instead of writing;
+  - for a choice that asks for more ("Somewhere else, where?"), the follow-up under "<key>_detail"."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from datetime import timedelta
+
+from django.db import transaction
+from django.utils import timezone
+from django.utils.translation import gettext_lazy as _
+
+from .models import Candidate, Feedback
+
+MAX_TEXT = 2000  # characters in one free-text answer
+MAX_DETAIL = 200  # characters in the short follow-up of a choice
+MAX_CHATS_PER_DAY = 20  # chats one person may start in 24 hours: stops accidents and abuse, not honest use
+
+
+class Invalid(ValueError):
+    """An answer the chat does not take; the message is shown to the person."""
+
+
+class LimitReached(Exception):
+    """The person already started the day's allowance of chats."""
+
+
+@dataclass(frozen=True)
+class Step:
+    key: str
+    text: object  # a lazy string
+    kind: str  # "text" or "choice"
+    choices: tuple = ()  # (key, label) buttons of a choice step
+    required: bool = False
+    quick: tuple | None = None  # (key, label): a button next to a text field that answers without writing
+    details: dict = field(default_factory=dict)  # choice key -> the follow-up question that choice asks
+
+
+MORE = Step("more", _("Anything else you want to add?"), "text")
+
+IDEA = [
+    Step("want", _("What would you like to be able to do?"), "text", required=True),
+    Step("value", _("How useful would that be to you?"), "choice",
+         choices=(("nice", _("Nice to have")), ("weekly", _("I'd use it every week")), ("daily", _("I'd use it every day")), ("vital", _("I can't do without it")))),
+    Step("today", _("What do you do today instead?"), "text", quick=("nothing", _("Nothing, I just can't"))),
+    Step("often", _("How often would you need it?"), "choice",
+         choices=(("daily", _("Every day")), ("weekly", _("Every week")), ("monthly", _("Once a month")), ("once", _("Once")))),
+    MORE,
+]
+PROBLEM = [
+    Step("what", _("What happened, and what did you expect?"), "text", required=True),
+    Step("where", _("Where did it happen?"), "choice", choices=(("page", _("On this page")), ("elsewhere", _("Somewhere else"))),
+         details={"elsewhere": _("Where was that?")}),
+    Step("impact", _("How much did it get in your way?"), "choice",
+         choices=(("small", _("A small annoyance")), ("slows", _("It slows me down")), ("blocked", _("I could not do what I came to do")))),
+    Step("repeat", _("Does it happen every time?"), "choice",
+         choices=(("always", _("Every time")), ("sometimes", _("Sometimes")), ("once", _("It happened once")))),
+    MORE,
+]
+OPINION = [
+    Step("about", _("What is it about?"), "choice", required=True,
+         choices=(("page", _("This page")), ("inbox", _("Inbox")), ("pipeline", _("Pipeline")), ("interviews", _("Interviews")), ("companies", _("Companies")),
+                  ("ai", _("The AI review")), ("emails", _("E-mails")), ("settings", _("Settings")), ("other", _("Something else"))),
+         details={"other": _("What would you call it?")}),
+    Step("value", _("How useful is it to you?"), "choice",
+         choices=(("none", _("Not useful")), ("little", _("A little useful")), ("useful", _("Useful")), ("very", _("Very useful")), ("vital", _("I can't do without it")))),
+    Step("good", _("What works well for you?"), "text"),
+    Step("change", _("What would you change?"), "text"),
+    MORE,
+]
+SCRIPT = {Feedback.IDEA: IDEA, Feedback.PROBLEM: PROBLEM, Feedback.OPINION: OPINION}
+
+# The three buttons that open a chat, in the order the person sees them.
+PATHS = [
+    (Feedback.IDEA, _("An idea or a missing feature")),
+    (Feedback.PROBLEM, _("Something is broken or confusing")),
+    (Feedback.OPINION, _("What I think of something that exists")),
+]
+
+DEVICES = ("phone", "desktop")
+PHONE_MAX_WIDTH = 900  # the app's own breakpoint: from 900 px the tab bar gives way to the top menu
+
+# How a page is called to the person ("You are on Inbox"): the route name -> a short name. A page not listed here is still recorded, just not named.
+PAGE_LABELS = {
+    "inbox": _("Inbox"), "archive": _("Archive"), "pipeline": _("Pipeline"), "job": _("A job"), "followup": _("A follow-up"),
+    "packet": _("An application packet"), "referral": _("A referral request"), "interviews": _("Interviews"), "companies": _("Companies"),
+    "company": _("A company"), "contacts": _("Contacts"), "insights": _("Insights"), "settings": _("Settings"), "email_prefs": _("E-mail settings"),
+    "more": _("More"), "cv": _("Your CV"), "cv_match": _("A CV match"), "suggest": _("Suggest an employer"), "welcome": _("Welcome"),
+    "welcome_review": _("Your profile"), "welcome_target": _("Your target"), "ask": _("Your questions"), "ask_recap": _("Your questions"),
+}
+
+
+def page_of(path: str) -> tuple[str, int | None]:
+    """The route name and the job or company number of a page of this site, from its path (what `location.pathname` says); ("", None) for anything
+    else. Reads the URL table only: no database."""
+    from django.urls import Resolver404, resolve
+
+    path = (path or "").split("?")[0].split("#")[0]
+    if not path.startswith("/") or path.startswith("//"):
+        return "", None
+    try:
+        match = resolve(path)
+    except Resolver404:
+        return "", None
+    number = next((match.kwargs[k] for k in ("pk", "job_pk") if isinstance(match.kwargs.get(k), int)), None)
+    return match.url_name or "", number
+
+
+def device_of(width) -> str:
+    """"phone" below the app's tab-bar breakpoint, "desktop" from it, "" when the width is not a number."""
+    try:
+        return "phone" if int(width) < PHONE_MAX_WIDTH else "desktop"
+    except (TypeError, ValueError):
+        return ""
+
+
+def steps(kind: str) -> list[Step]:
+    try:
+        return SCRIPT[kind]
+    except KeyError:
+        raise Invalid(_("Pick one of the three buttons.")) from None
+
+
+def next_step(kind: str, answers: dict) -> Step | None:
+    """The first question not answered or skipped yet, None when the chat is over."""
+    return next((s for s in steps(kind) if s.key not in answers), None)
+
+
+def check(step: Step, value: str = "", detail: str = "", quick: str = ""):
+    """Read one submitted answer. Returns (what to store, follow-up to store or None); the stored value is None for a skip. Raises Invalid."""
+    value, detail, quick = (value or "").strip(), (detail or "").strip(), (quick or "").strip()
+    if step.kind == "text":
+        if quick and step.quick and quick == step.quick[0]:
+            return {"quick": quick}, None
+        if not value:
+            if step.required:
+                raise Invalid(_("Please write a few words first."))
+            return None, None
+        if len(value) > MAX_TEXT:
+            raise Invalid(_("That is a bit long: please keep it under %(n)d characters.") % {"n": MAX_TEXT})
+        return value, None
+    if not value:
+        if step.required:
+            raise Invalid(_("Please pick one of the buttons."))
+        return None, None
+    if value not in dict(step.choices):
+        raise Invalid(_("Please pick one of the buttons."))
+    if value in step.details and detail:
+        if len(detail) > MAX_DETAIL:
+            raise Invalid(_("That is a bit long: please keep it under %(n)d characters.") % {"n": MAX_DETAIL})
+        return value, detail
+    return value, None
+
+
+def chats_left(candidate: Candidate, now=None) -> int:
+    since = (now or timezone.now()) - timedelta(hours=24)
+    return max(0, MAX_CHATS_PER_DAY - Feedback.objects.filter(candidate=candidate, created_at__gte=since).count())
+
+
+def clean_context(raw: dict | None, candidate: Candidate) -> dict:
+    """What the app attaches to a chat. Only known keys, short; the person's mode and language come from their account, never from the request."""
+    raw = raw or {}
+    page = str(raw.get("page") or "")[:60]
+    try:
+        object_id = int(raw["object_id"]) if raw.get("object_id") not in (None, "") else None
+    except (TypeError, ValueError):
+        object_id = None
+    device = raw.get("device") if raw.get("device") in DEVICES else ""
+    return {"page": page, "object_id": object_id, "device": device, "mode": candidate.mode, "language": candidate.language or str(raw.get("language") or "")[:2]}
+
+
+def answer(candidate: Candidate, chat: Feedback | None, kind: str, key: str, value: str = "", detail: str = "", quick: str = "",
+           context: dict | None = None) -> Feedback:
+    """Save one answer and return the chat. With no chat yet this is the first answer: it makes the row (after the daily limit), nothing is written
+    before. The answer must be to the current question. Raises Invalid, LimitReached."""
+    if chat is not None and chat.candidate_id != candidate.pk:
+        raise PermissionError("not this person's chat")
+    with transaction.atomic():
+        if chat is None:
+            script = steps(kind)
+            step = script[0]
+        else:
+            if chat.completed:
+                raise Invalid(_("This chat is finished."))
+            step = next_step(chat.kind, chat.answers)
+        if step is None or key != step.key:
+            raise Invalid(_("That is not the current question."))
+        stored, stored_detail = check(step, value, detail, quick)
+        if chat is None:
+            if chats_left(candidate) <= 0:
+                raise LimitReached
+            chat = Feedback(candidate=candidate, kind=kind, context=clean_context(context, candidate))
+        chat.answers = {**chat.answers, step.key: stored, **({f"{step.key}_detail": stored_detail} if stored_detail else {})}
+        chat.completed = next_step(chat.kind, chat.answers) is None
+        chat.save()
+    return chat
+
+
+def readable(chat: Feedback) -> list[tuple[str, str, str]]:
+    """The conversation as (key, question, answer) triples in the active language. A skipped question reads "(skipped)"; questions not reached
+    are left out."""
+    out = []
+    for step in steps(chat.kind):
+        if step.key not in chat.answers:
+            continue
+        stored = chat.answers[step.key]
+        if stored is None:
+            text = str(_("(skipped)"))
+        elif isinstance(stored, dict):
+            text = str(step.quick[1]) if step.quick else str(stored.get("quick", ""))
+        elif step.kind == "choice":
+            text = str(dict(step.choices).get(stored, stored))
+            if chat.answers.get(f"{step.key}_detail"):
+                text += f": {chat.answers[f'{step.key}_detail']}"
+        else:
+            text = str(stored)
+        out.append((step.key, str(step.text), text))
+    return out
+
+
+def describe(chat: Feedback) -> list[tuple[str, str]]:
+    """The conversation as (question, answer) pairs, for the sheet and the console."""
+    return [(question, answer) for _key, question, answer in readable(chat)]
+
+
+# ---------------------------------------------------------------- the owner's side: an item as the start of an intent file
+
+REQUEST_KEYS = {Feedback.IDEA: ("want",), Feedback.PROBLEM: ("what",), Feedback.OPINION: ("change", "good")}  # the words that become "the request"
+PAIN_KEYS = {Feedback.IDEA: ("today",), Feedback.PROBLEM: ("impact", "repeat"), Feedback.OPINION: ()}  # what goes under "the pain"
+KIND_LABELS = {Feedback.IDEA: "an idea", Feedback.PROBLEM: "a problem", Feedback.OPINION: "an opinion"}
+
+
+def reference(candidate: Candidate) -> str:
+    """How the console names a person: C-02, as the "view as" banner does."""
+    return f"C-{candidate.pk:02d}"
+
+
+def first_name(candidate: Candidate) -> str:
+    """The first word of the person's name; nothing when the name is an e-mail address (an address does not belong in an intent file)."""
+    name = (candidate.name or "").strip()
+    return "" if not name or "@" in name else name.split()[0]
+
+
+def who(candidate: Candidate) -> str:
+    name = first_name(candidate)
+    return f"{reference(candidate)} ({name})" if name else reference(candidate)
+
+
+def intent_draft(chat: Feedback, today=None) -> str:
+    """The item in the shape of docs/sdlc/templates/intent.md, in English, to paste into a new cycle: their words verbatim as the request, what they
+    said about today as the pain, everything else as facts with their source. The goal, the measure and the questions are left to the owner."""
+    from django.utils import timezone, translation
+
+    today = today or timezone.localdate()
+    with translation.override("en"):
+        items = readable(chat)
+        page = str(PAGE_LABELS.get(chat.context.get("page"), "")) or chat.context.get("page") or "a page we did not name"
+    answers = {key: (question, answer) for key, question, answer in items}
+    real = lambda key: key in answers and chat.answers.get(key) is not None  # noqa: E731  an answer that is not a skip
+    request_key = next((k for k in REQUEST_KEYS[chat.kind] if real(k) and isinstance(chat.answers[k], str)), None)
+    request = chat.answers[request_key] if request_key else "(no free text: see the answers below)"
+    short = " ".join(request.split())[:60] if request_key else f"feedback {chat.pk}"
+    pain = [f"- {answers[k][0]} {answers[k][1]}" for k in PAIN_KEYS[chat.kind] if real(k) and k != request_key]
+    facts = [f"- {question} {answer}" for key, (question, answer) in answers.items() if real(key) and key != request_key and key not in PAIN_KEYS[chat.kind]]
+    context = chat.context
+    where = ", ".join(x for x in (page, context.get("device"), f"{context['mode']} mode" if context.get("mode") else "", f"language {context['language']}" if context.get("language") else "") if x)
+    sources = [f"- Said by {who(chat.candidate)} through the feedback chat (#{chat.pk}) on {timezone.localtime(chat.created_at):%Y-%m-%d}, on {where}."]
+    if not chat.completed:
+        sources.append("- The chat was not finished: only the answers above were given.")
+    quoted = "\n".join(f"> {line}" if line.strip() else ">" for line in request.splitlines()) or "> "
+    return "\n".join([
+        f"# Intent: {short}", "",
+        "| | |", "|---|---|", "| **Cycle** | NNN |", "| **Stage** | Intent |", f"| **Date** | {today:%Y-%m-%d} |", "| **Owner** | Vlad |",
+        f"| **Born from** | Feedback #{chat.pk}: {KIND_LABELS[chat.kind]} from {who(chat.candidate)} |", "",
+        "## The request, in your words", quoted, "",
+        "## Why now / the pain", *(pain or ["<to fill: what hurts today, with numbers where they exist>"]), "",
+        "## Goal", "<to fill: the outcome, not the solution>", "",
+        "## Success measure", "<to fill: how we will know, measurable>", "",
+        "## Not doing (this cycle)", "-", "",
+        "## What we already know (facts, with where they came from)", *sources, *facts, "",
+        "## Open questions (grilled one at a time)",
+        "| # | Question | Recommended answer | Answer | Status |", "|---|----------|--------------------|--------|--------|", "",
+        "## Constraints and risks", "-", "",
+        "## Gate", "- [ ] All open questions answered or parked", "- [ ] Goal and success measure confirmed by the owner", "",
+    ])
