+{% load i18n %}{# The feedback chat's sheet: the conversation so far, then the next question (or the thanks). Swapped into #feedback-body. #}
+<div class="chat feedback-chat">
+  {% if not kind and not chat %}
+  <div class="bubble q"><strong>{% trans "What would you like to tell me?" %}</strong></div>
+  <div class="bubble q">{% if page_label %}{% blocktranslate with page=page_label %}You are on “{{ page }}”.{% endblocktranslate %} {% endif %}{% trans "What you write here is tied to your account, and I read all of it." %}</div>
+  {% if error %}<div class="bubble q fb-error" role="alert">{{ error }}</div>{% endif %}
+  {% elif kind_label %}
+  <div class="bubble a">{{ kind_label }}</div>
+  {% endif %}
+
+  {% for question, reply in pairs %}
+  <div class="bubble q">{{ question }}</div>
+  <div class="bubble a">{{ reply }}</div>
+  {% endfor %}
+
+  {% if limit %}
+  <div class="bubble q">{% trans "That is plenty for today, thank you. Come back tomorrow and tell me more." %}</div>
+  {% elif done %}
+  <div class="bubble q"><strong>{% trans "Thank you, I read every one." %}</strong></div>
+  {% endif %}
+</div>
+
+{% if not kind and not chat and not limit %}
+<div class="fb-paths">
+  {% for key, label in paths %}
+  <form hx-get="{% url 'feedback_open' %}" hx-target="#feedback-body" hx-swap="innerHTML">
+    <input type="hidden" name="kind" value="{{ key }}">{% include "jobs/_feedback_hidden.html" %}
+    <button type="submit" class="fb-path">{{ label }}</button>
+  </form>
+  {% endfor %}
+</div>
+
+{% elif step %}
+<div class="chat feedback-chat">
+  <div class="bubble q"><strong>{{ step.text }}</strong></div>
+  {% if error %}<div class="bubble q fb-error" role="alert">{{ error }}</div>{% endif %}
+</div>
+
+{% if step.kind == "text" %}
+<form class="fb-reply" hx-post="{% url 'feedback_answer' %}" hx-target="#feedback-body" hx-swap="innerHTML">{% csrf_token %}
+  {% include "jobs/_feedback_hidden.html" %}
+  <input type="hidden" name="chat" value="{{ chat.pk|default:'' }}"><input type="hidden" name="kind" value="{{ kind }}"><input type="hidden" name="key" value="{{ step.key }}">
+  <textarea name="value" rows="3" maxlength="{{ max_text }}" aria-label="{{ step.text }}" placeholder="{% trans "Write here" %}" {% if step.required %}required{% endif %}></textarea>
+  <div class="row">
+    <button type="submit" class="primary">{% trans "Send" %}</button>
+    {% if step.quick %}<button type="submit" name="quick" value="{{ step.quick.0 }}" formnovalidate>{{ step.quick.1 }}</button>{% endif %}
+    {% if not step.required %}<button type="submit" name="skip" value="1" formnovalidate>{% trans "Skip" %}</button>{% endif %}
+  </div>
+</form>
+
+{% else %}
+<form class="fb-reply" hx-post="{% url 'feedback_answer' %}" hx-target="#feedback-body" hx-swap="innerHTML">{% csrf_token %}
+  {% include "jobs/_feedback_hidden.html" %}
+  <input type="hidden" name="chat" value="{{ chat.pk|default:'' }}"><input type="hidden" name="kind" value="{{ kind }}"><input type="hidden" name="key" value="{{ step.key }}">
+  <div class="chips">
+    {% for key, label in step.choices %}{% if key not in step.details %}<button type="submit" class="chip" name="value" value="{{ key }}">{{ label }}</button>{% endif %}{% endfor %}
+    {% if not step.required %}<button type="submit" class="chip" name="skip" value="1">{% trans "Skip" %}</button>{% endif %}
+  </div>
+</form>
+{# A choice that asks for a few more words ("Somewhere else: where?") is its own small form, so Enter in its field cannot pick another button. #}
+{% for key, label in step.choices %}{% if key in step.details %}
+<form class="fb-reply" hx-post="{% url 'feedback_answer' %}" hx-target="#feedback-body" hx-swap="innerHTML">{% csrf_token %}
+  {% include "jobs/_feedback_hidden.html" %}
+  <input type="hidden" name="chat" value="{{ chat.pk|default:'' }}"><input type="hidden" name="kind" value="{{ kind }}"><input type="hidden" name="key" value="{{ step.key }}">
+  <input type="hidden" name="value" value="{{ key }}">
+  <div class="row"><input type="text" name="detail" maxlength="{{ max_detail }}" aria-label="{{ label }}" placeholder="{% for k, prompt in step.details.items %}{% if k == key %}{{ prompt }}{% endif %}{% endfor %}" style="flex:1;min-width:160px"><button type="submit" class="chip">{{ label }}</button></div>
+</form>
+{% endif %}{% endfor %}
+{% endif %}
+
+{% elif done or limit %}
+<form class="fb-reply row" hx-get="{% url 'feedback_open' %}" hx-target="#feedback-body" hx-swap="innerHTML">
+  {% include "jobs/_feedback_hidden.html" %}
+  {% if done %}<button type="submit" class="primary">{% trans "Tell me something else" %}</button>{% endif %}
+  <button type="button" data-sheet-close>{% trans "Close" %}</button>
+</form>
+{% endif %}
