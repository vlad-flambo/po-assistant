+def _import_feedback(entries: Any, candidate: Candidate, report: ImportReport, replace: bool) -> None:
+    """The person's chats from a file. Replace: theirs are emptied and the file's put back; merge: only a chat not there yet (same kind, same moment)
+    is added. A chat of an unknown kind, with answers that are not an object or too large, is skipped. The owner's notes in the file are ignored."""
+    if not isinstance(entries, list):
+        report.warn("skipped the feedback: it should be a list")
+        return
+    if replace:
+        Feedback.objects.filter(candidate=candidate).delete()
+    have = {(f.kind, f.created_at) for f in Feedback.objects.filter(candidate=candidate).only("kind", "created_at")}
+    for entry in entries[:MAX_FEEDBACK]:
+        values = _load(Feedback, entry) if isinstance(entry, dict) else {}
+        values = {k: v for k, v in values.items() if k not in FEEDBACK_OWNERS_NOTES}
+        answers, context = values.get("answers"), values.get("context", {})
+        if (values.get("kind") not in feedback_script.SCRIPT or not isinstance(answers, dict) or not isinstance(context, dict)
+                or len(json.dumps([answers, context])) > MAX_FEEDBACK_BYTES):
+            report.warn("skipped a feedback chat that could not be read")
+            continue
+        if (values["kind"], values.get("created_at")) in have:
+            continue
+        Feedback.objects.create(candidate=candidate, **values)
+        have.add((values["kind"], values.get("created_at")))
+        report.feedback_added += 1
+    if len(entries) > MAX_FEEDBACK:
+        report.warn(f"read the first {MAX_FEEDBACK} feedback chats only")
+
+
 def _import_sources(entries: list[dict[str, Any]], report: ImportReport) -> dict[tuple[str, str], Source]:
