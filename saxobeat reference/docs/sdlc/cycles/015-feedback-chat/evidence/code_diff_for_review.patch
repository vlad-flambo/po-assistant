@@ -0,0 +1,122 @@
+"""Cycle 015, slice 7: what a person told the feedback chat is in their own data export and comes back with a restore; the owner's notes on it do not."""
+
+import json
+from datetime import timedelta
+
+import pytest
+from django.contrib.auth import get_user_model
+from django.test import Client
+from django.utils import timezone
+
+from jobs import feedback
+from jobs.models import Candidate, Feedback
+from jobs.services import backup
+
+pytestmark = pytest.mark.django_db
+
+
+def person(name):
+    user = get_user_model().objects.create_user(f"{name}@x.test", email=f"{name}@x.test", password="pw-for-tests")
+    return Candidate.for_user(user)
+
+
+def chat(candidate, text, kind="idea", ago=0, **extra):
+    row = Feedback.objects.create(candidate=candidate, kind=kind, answers={"want": text} if kind == "idea" else {"what": text}, completed=False,
+                                  context={"page": "pipeline", "object_id": None, "device": "phone", "mode": "standard", "language": "fr"}, **extra)
+    Feedback.objects.filter(pk=row.pk).update(created_at=timezone.now() - timedelta(hours=ago))
+    row.refresh_from_db()
+    return row
+
+
+def test_a_persons_export_holds_their_own_chats_without_the_owners_notes():
+    marie, paul = person("marie"), person("paul")
+    chat(marie, "Remind me", state="cycle", cycle_ref="016")
+    chat(marie, "It broke", kind="problem", ago=5)
+    chat(paul, "Paul's secret idea")
+    data = backup.export_data(candidate=marie)
+    assert data["counts"]["feedback"] == 2 and len(data["feedback"]) == 2
+    texts = json.dumps(data["feedback"])
+    assert "Remind me" in texts and "It broke" in texts and "Paul's secret idea" not in texts
+    for entry in data["feedback"]:
+        assert "state" not in entry and "cycle_ref" not in entry  # the owner's triage is not theirs to take
+        assert set(entry) == {"kind", "answers", "context", "completed", "created_at", "updated_at"}
+    assert data["feedback"][0]["created_at"] < data["feedback"][1]["created_at"]  # oldest first
+
+
+def test_the_export_is_valid_json_and_still_a_valid_backup_file():
+    marie = person("marie")
+    chat(marie, "Remind me")
+    parsed = backup.parse(backup.to_bytes(backup.export_data(candidate=marie), compress=True))
+    assert parsed["feedback"][0]["answers"] == {"want": "Remind me"}
+
+
+def test_a_replace_puts_the_chats_back_and_leaves_other_peoples_alone():
+    marie, paul = person("marie"), person("paul")
+    original = chat(marie, "Remind me", ago=30)
+    chat(paul, "Paul's idea")
+    data = backup.parse(backup.to_bytes(backup.export_data(candidate=marie)))
+    Feedback.objects.filter(candidate=marie).delete()
+    chat(marie, "Something typed after the backup")
+    report = backup.import_data(data, mode="replace", candidate=marie)
+    mine = list(Feedback.objects.filter(candidate=marie))
+    assert [f.answers for f in mine] == [{"want": "Remind me"}] and report.feedback_added == 1
+    assert mine[0].created_at == original.created_at and mine[0].state == "new" and mine[0].cycle_ref == ""
+    assert Feedback.objects.filter(candidate=paul).count() == 1
+    assert "1 feedback chats restored" in report.summary()
+
+
+def test_a_merge_adds_only_what_is_missing_and_twice_changes_nothing():
+    marie = person("marie")
+    chat(marie, "Kept", ago=10)
+    data = backup.parse(backup.to_bytes(backup.export_data(candidate=marie)))
+    Feedback.objects.filter(candidate=marie).delete()
+    chat(marie, "Newer", ago=1)
+    assert backup.import_data(data, mode="merge", candidate=marie).feedback_added == 1
+    assert backup.import_data(data, mode="merge", candidate=marie).feedback_added == 0
+    assert sorted(f.answers["want"] for f in Feedback.objects.filter(candidate=marie)) == ["Kept", "Newer"]
+
+
+def test_a_file_from_before_the_chat_does_not_empty_the_chats_a_person_has():
+    marie = person("marie")
+    chat(marie, "Told after that backup")
+    old_file = backup.parse(backup.to_bytes({k: v for k, v in backup.export_data(candidate=marie).items() if k not in ("feedback",)}))
+    assert "feedback" not in old_file
+    backup.import_data(old_file, mode="replace", candidate=marie)
+    assert Feedback.objects.filter(candidate=marie).count() == 1
+
+
+def test_chats_that_cannot_be_read_are_skipped_with_a_warning_and_the_owners_notes_are_ignored():
+    marie = person("marie")
+    good = {"kind": "idea", "answers": {"want": "Fine"}, "context": {}, "completed": True, "created_at": timezone.now().isoformat(), "state": "cycle", "cycle_ref": "016"}
+    bad = [{"kind": "complaint", "answers": {}}, {"kind": "idea", "answers": "text"}, {"kind": "idea", "answers": {"want": "x" * 50_000}}, "not an object", {"kind": "idea", "answers": {"a": 1}, "context": []}]
+    data = backup.parse(json.dumps({"schema": "saxobeat.backup.v1", "jobs": [], "sources": [], "feedback": [good, *bad]}).encode())
+    report = backup.import_data(data, mode="merge", candidate=marie)
+    assert report.feedback_added == 1 and len(report.warnings) == 5
+    row = Feedback.objects.get(candidate=marie)
+    assert row.state == "new" and row.cycle_ref == "" and row.completed
+    not_a_list = backup.parse(json.dumps({"schema": "saxobeat.backup.v1", "jobs": [], "sources": [], "feedback": {"kind": "idea"}}).encode())
+    assert backup.import_data(not_a_list, mode="merge", candidate=marie).feedback_added == 0
+    assert Feedback.objects.filter(candidate=marie).count() == 1
+
+
+def test_a_file_cannot_bring_in_more_than_a_thousand_chats():
+    marie = person("marie")
+    now = timezone.now()
+    many = [{"kind": "idea", "answers": {"want": str(i)}, "context": {}, "created_at": (now - timedelta(minutes=i)).isoformat()} for i in range(backup.MAX_FEEDBACK + 5)]
+    data = backup.parse(json.dumps({"schema": "saxobeat.backup.v1", "jobs": [], "sources": [], "feedback": many}).encode())
+    assert backup.import_data(data, mode="merge", candidate=marie).feedback_added == backup.MAX_FEEDBACK
+
+
+def test_the_download_button_gives_a_person_their_own_chats_and_nobody_elses():
+    marie, paul = person("marie"), person("paul")
+    chat(marie, "Marie's idea")
+    chat(paul, "Paul's idea")
+    client = Client()
+    client.login(username="marie@x.test", password="pw-for-tests")
+    body = client.get("/data/export/").content.decode()
+    assert "Marie's idea" in body and "Paul's idea" not in body
+    assert json.loads(body)["counts"]["feedback"] == 1
+
+
+def test_the_chat_script_kinds_are_the_ones_the_import_accepts():
+    assert set(feedback.SCRIPT) == {"idea", "problem", "opinion"}
