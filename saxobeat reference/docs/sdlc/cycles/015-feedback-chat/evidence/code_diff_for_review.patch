     dialog.querySelector("[data-byo-cancel]").addEventListener("click", function () { dialog.close(); });
   }
 })();
+
+/* The feedback chat's sheet (docs/sdlc/cycles/015-feedback-chat): the button opens it (the generic sheet code above) and htmx fills it. Here: put the
+   cursor in a text box when the question is a text, show the latest bubble, and keep the sheet above the phone's keyboard. */
+(function () {
+  "use strict";
+  var sheet = document.getElementById("feedback-sheet"), body = document.getElementById("feedback-body");
+  if (!sheet || !body) return;
+
+  body.addEventListener("htmx:afterSwap", function () {
+    var field = body.querySelector("textarea");
+    if (field && sheet.open) field.focus({preventScroll: true});
+    var last = body.querySelector(".bubble:last-of-type, .fb-reply");
+    sheet.scrollTop = sheet.scrollHeight;                    // the newest question and its answers are at the bottom
+    if (last && last.scrollIntoView) last.scrollIntoView({block: "nearest"});
+  });
+
+  // On a phone the keyboard covers the bottom of the page: size and lift the sheet to what is really visible (the visual viewport), and give it back when it closes.
+  var vv = window.visualViewport;
+  function release() { sheet.style.bottom = ""; sheet.style.maxHeight = ""; }
+  function fit() {
+    if (!vv || !sheet.open) return;
+    var covered = window.innerHeight - vv.height - vv.offsetTop;   // what the keyboard hides at the bottom
+    if (window.innerWidth >= 900 || window.innerHeight - vv.height < 100) return release();  // wide screens centre the sheet; no keyboard, nothing to do
+    sheet.style.bottom = Math.max(0, covered) + "px";
+    sheet.style.maxHeight = Math.max(160, vv.height - 12) + "px";
+  }
+  if (vv) {
+    vv.addEventListener("resize", fit);
+    vv.addEventListener("scroll", fit);
+  }
+  sheet.addEventListener("close", release);
+  sheet.addEventListener("focusin", function () { setTimeout(fit, 50); });
+})();
+
+/* A "Copy" button: <button data-copy="id"> copies the text of the <textarea id="..."> (the operator's feedback page: an item as the start of an intent file). */
+document.addEventListener("click", function (e) {
+  var button = e.target.closest("[data-copy]");
+  var box = button && document.getElementById(button.dataset.copy);
+  if (!box) return;
+  var label = button.textContent;
+  function said() { button.textContent = button.dataset.copied || "Copied"; setTimeout(function () { button.textContent = label; }, 1600); }
+  box.focus(); box.select();
+  if (navigator.clipboard && window.isSecureContext) {
+    navigator.clipboard.writeText(box.value).then(said, function () { if (document.execCommand("copy")) said(); });
+  } else if (document.execCommand("copy")) {
+    said();
+  }
+});
