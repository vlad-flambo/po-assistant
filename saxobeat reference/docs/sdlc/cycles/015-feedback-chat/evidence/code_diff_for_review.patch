+"""Cycle 015, the feedback chat: the script (the three question lists, the answer checks, the limits) and how a chat is kept.
+See docs/sdlc/cycles/015-feedback-chat/spec.md."""
+
+from datetime import timedelta
+
+import pytest
+from django.utils import timezone
+
+from jobs import feedback
+from jobs.feedback import Invalid, LimitReached
+from jobs.models import Candidate, Feedback
+
+pytestmark = pytest.mark.django_db
+
+KINDS = [Feedback.IDEA, Feedback.PROBLEM, Feedback.OPINION]
+
+
+@pytest.fixture
+def marie():
+    return Candidate.objects.create(name="Marie", mode="standard", language="fr")
+
+
+def first_text(kind):
+    return {"idea": "Remind me before an interview", "problem": "The save button did nothing", "opinion": "inbox"}[kind]
+
+
+def test_there_are_three_paths_with_five_questions_each():
+    assert [k for k, _ in feedback.PATHS] == KINDS
+    for kind in KINDS:
+        script = feedback.steps(kind)
+        assert len(script) == 5
+        assert len({s.key for s in script}) == 5
+        assert script[0].required and not any(s.required for s in script[1:])  # only the first is required, the rest can be skipped
+        for s in script:
+            assert s.kind in ("text", "choice")
+            if s.kind == "choice":
+                assert len(s.choices) >= 2 and len({c[0] for c in s.choices}) == len(s.choices)
+
+
+def test_the_idea_path_is_the_one_the_owner_accepted():
+    script = feedback.steps("idea")
+    assert [s.key for s in script] == ["want", "value", "today", "often", "more"]
+    assert [c[0] for c in script[1].choices] == ["nice", "weekly", "daily", "vital"]  # nice to have / every week / every day / can't do without
+    assert script[2].quick[0] == "nothing"  # "Nothing, I just can't" next to the text field
+    assert [c[0] for c in script[3].choices] == ["daily", "weekly", "monthly", "once"]
+
+
+def test_an_unknown_kind_is_refused():
+    with pytest.raises(Invalid):
+        feedback.steps("complaint")
+
+
+def test_next_step_walks_the_list_and_ends():
+    answers = {}
+    seen = []
+    while (step := feedback.next_step("problem", answers)) is not None:
+        seen.append(step.key)
+        answers[step.key] = None
+    assert seen == ["what", "where", "impact", "repeat", "more"]
+
+
+def test_a_text_is_trimmed_and_an_empty_optional_one_is_a_skip():
+    step = feedback.steps("idea")[4]
+    assert feedback.check(step, "  more please \n") == ("more please", None)
+    assert feedback.check(step, "   ") == (None, None)
+
+
+def test_the_first_answer_cannot_be_empty():
+    for kind in KINDS:
+        with pytest.raises(Invalid):
+            feedback.check(feedback.steps(kind)[0], "  ")
+
+
+def test_a_text_over_two_thousand_characters_is_refused_and_two_thousand_is_fine():
+    step = feedback.steps("idea")[0]
+    assert feedback.check(step, "x" * 2000)[0] == "x" * 2000
+    with pytest.raises(Invalid):
+        feedback.check(step, "x" * 2001)
+
+
+def test_a_choice_must_be_one_of_the_buttons():
+    step = feedback.steps("idea")[1]
+    assert feedback.check(step, "weekly") == ("weekly", None)
+    assert feedback.check(step, "") == (None, None)
+    with pytest.raises(Invalid):
+        feedback.check(step, "sometimes")
+
+
+def test_the_quick_button_answers_without_writing():
+    step = feedback.steps("idea")[2]
+    assert feedback.check(step, "", quick="nothing") == ({"quick": "nothing"}, None)
+    assert feedback.check(step, "I keep a spreadsheet") == ("I keep a spreadsheet", None)
+    assert feedback.check(step, "", quick="something else") == (None, None)  # an unknown quick key is just an empty answer
+
+
+def test_somewhere_else_asks_where_and_keeps_the_short_text():
+    step = feedback.steps("problem")[1]
+    assert feedback.check(step, "elsewhere", "the CV page") == ("elsewhere", "the CV page")
+    assert feedback.check(step, "page", "ignored") == ("page", None)  # only the choices that ask keep a follow-up
+    with pytest.raises(Invalid):
+        feedback.check(step, "elsewhere", "y" * (feedback.MAX_DETAIL + 1))
+
+
+def test_opening_is_not_an_answer_and_the_first_answer_makes_one_row(marie):
+    assert Feedback.objects.count() == 0
+    chat = feedback.answer(marie, None, "idea", "want", "Remind me before an interview", context={"page": "pipeline", "device": "phone"})
+    assert Feedback.objects.count() == 1
+    assert chat.kind == "idea" and chat.candidate == marie and not chat.completed and chat.state == "new"
+    assert chat.answers == {"want": "Remind me before an interview"}
+
+
+def test_later_answers_update_the_same_row_and_the_last_one_completes_it(marie):
+    chat = feedback.answer(marie, None, "idea", "want", "Remind me")
+    chat = feedback.answer(marie, chat, "idea", "value", "daily")
+    chat = feedback.answer(marie, chat, "idea", "today", quick="nothing")
+    chat = feedback.answer(marie, chat, "idea", "often", "")  # skipped
+    assert not chat.completed
+    chat = feedback.answer(marie, chat, "idea", "more", "Thanks")
+    assert chat.completed and Feedback.objects.count() == 1
+    assert Feedback.objects.get().answers == {"want": "Remind me", "value": "daily", "today": {"quick": "nothing"}, "often": None, "more": "Thanks"}
+
+
+def test_half_a_chat_is_kept(marie):
+    feedback.answer(marie, None, "opinion", "about", "pipeline")
+    kept = Feedback.objects.get()
+    assert not kept.completed and kept.answers == {"about": "pipeline"}
+
+
+def test_an_empty_first_answer_creates_nothing(marie):
+    for kind in KINDS:
+        with pytest.raises(Invalid):
+            feedback.answer(marie, None, kind, feedback.steps(kind)[0].key, "   ")
+    assert Feedback.objects.count() == 0
+
+
+def test_the_answer_must_be_to_the_current_question(marie):
+    with pytest.raises(Invalid):
+        feedback.answer(marie, None, "idea", "value", "daily")  # a chat starts with the first question
+    chat = feedback.answer(marie, None, "idea", "want", "x")
+    with pytest.raises(Invalid):
+        feedback.answer(marie, chat, "idea", "often", "daily")  # skipping ahead
+    with pytest.raises(Invalid):
+        feedback.answer(marie, chat, "idea", "want", "again")  # answering twice
+    assert Feedback.objects.get().answers == {"want": "x"}
+
+
+def test_a_finished_chat_takes_nothing_more(marie):
+    chat = feedback.answer(marie, None, "problem", "what", "It broke")
+    for key in ("where", "impact", "repeat", "more"):
+        chat = feedback.answer(marie, chat, "problem", key, "")
+    assert chat.completed
+    with pytest.raises(Invalid):
+        feedback.answer(marie, chat, "problem", "more", "late")
+
+
+def test_nobody_answers_in_someone_elses_chat(marie):
+    paul = Candidate.objects.create(name="Paul")
+    chat = feedback.answer(marie, None, "idea", "want", "x")
+    with pytest.raises(PermissionError):
+        feedback.answer(paul, chat, "idea", "value", "daily")
+    assert Feedback.objects.get().answers == {"want": "x"}
+
+
+def test_the_kind_of_a_started_chat_cannot_be_switched(marie):
+    chat = feedback.answer(marie, None, "idea", "want", "x")
+    with pytest.raises(Invalid):
+        feedback.answer(marie, chat, "problem", "where", "page")  # "where" is not the idea's current question
+    assert Feedback.objects.get().kind == "idea"
+
+
+def test_twenty_chats_a_day_then_come_back_tomorrow(marie):
+    for i in range(feedback.MAX_CHATS_PER_DAY):
+        feedback.answer(marie, None, "idea", "want", f"idea {i}")
+    assert feedback.chats_left(marie) == 0
+    with pytest.raises(LimitReached):
+        feedback.answer(marie, None, "idea", "want", "one too many")
+    assert Feedback.objects.count() == feedback.MAX_CHATS_PER_DAY
+    # someone else is not affected, and a day later the allowance is back
+    assert feedback.answer(Candidate.objects.create(name="Paul"), None, "idea", "want", "mine").pk
+    Feedback.objects.filter(candidate=marie).update(created_at=timezone.now() - timedelta(hours=25))
+    assert feedback.chats_left(marie) == feedback.MAX_CHATS_PER_DAY
+
+
+def test_a_refused_answer_does_not_use_up_the_allowance(marie):
+    with pytest.raises(Invalid):
+        feedback.answer(marie, None, "idea", "want", "")
+    assert feedback.chats_left(marie) == feedback.MAX_CHATS_PER_DAY
+
+
+def test_the_context_keeps_only_what_it_knows(marie):
+    chat = feedback.answer(marie, None, "idea", "want", "x", context={"page": "job", "object_id": "42", "device": "phone", "mode": "power",
+                                                                    "language": "en", "secret": "no", "is_superuser": True})
+    assert chat.context == {"page": "job", "object_id": 42, "device": "phone", "mode": "standard", "language": "fr"}  # mode and language: the account's
+    blank = Candidate.objects.create(name="Blank")  # no language chosen yet: the language of the page they were on is used (two letters at most)
+    odd = feedback.clean_context({"page": "x" * 200, "object_id": "abc", "device": "toaster", "language": "english"}, blank)
+    assert odd == {"page": "x" * 60, "object_id": None, "device": "", "mode": blank.mode, "language": "en"}
+
+
+def test_a_chat_is_read_back_as_questions_and_answers(marie):
+    chat = feedback.answer(marie, None, "problem", "what", "The save button did nothing")
+    chat = feedback.answer(marie, chat, "problem", "where", "elsewhere", "Settings")
+    chat = feedback.answer(marie, chat, "problem", "impact", "")
+    pairs = feedback.describe(chat)
+    assert pairs == [("What happened, and what did you expect?", "The save button did nothing"), ("Where did it happen?", "Somewhere else: Settings"),
+                     ("How much did it get in your way?", "(skipped)")]
+    idea = feedback.answer(marie, None, "idea", "want", "x")
+    idea = feedback.answer(marie, idea, "idea", "value", "vital")
+    idea = feedback.answer(marie, idea, "idea", "today", quick="nothing")
+    assert [a for _, a in feedback.describe(idea)] == ["x", "I can't do without it", "Nothing, I just can't"]
+
+
+def test_deleting_the_person_deletes_their_feedback(marie):
+    feedback.answer(marie, None, "idea", "want", "x")
+    paul = Candidate.objects.create(name="Paul")
+    feedback.answer(paul, None, "idea", "want", "y")
+    marie.delete()
+    assert list(Feedback.objects.values_list("answers", flat=True)) == [{"want": "y"}]
+
+
+def test_the_chat_calls_no_outside_service():
+    """No AI, no network, no e-mail: the module imports none of them (cycle 015, criterion 14)."""
+    import ast
+    import pathlib
+
+    tree = ast.parse(pathlib.Path(feedback.__file__).read_text(encoding="utf-8"))
+    names = {n.module or "" for n in ast.walk(tree) if isinstance(n, ast.ImportFrom)} | {a.name for n in ast.walk(tree) if isinstance(n, ast.Import) for a in n.names}
+    assert not {n for n in names if n.split(".")[0] in ("requests", "httpx", "anymail", "urllib", "smtplib", "socket") or n.startswith(("jobs.ai", "jobs.mail"))}
+    assert not any(n in (".ai", ".mail") or n.startswith((".ai.", ".mail.")) for n in names)
