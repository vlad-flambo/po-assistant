+"""Cycle 015, slice 5: the operator's Feedback page: the list, the filters, the states, the nav count and the intent draft.
+See docs/sdlc/cycles/015-feedback-chat/spec.md."""
+
+import html as html_lib
+import pathlib
+import re
+
+import pytest
+from django.contrib.auth import get_user_model
+from django.db import connection
+from django.test import Client
+from django.test.utils import CaptureQueriesContext
+from django.utils import translation
+
+from jobs import feedback
+from jobs.models import Candidate, Feedback
+from tests.helpers import make_job
+
+pytestmark = pytest.mark.django_db
+
+PAGE, STATE = "/ops/feedback/", "/ops/feedback/{}/state/"
+
+
+def sign_in(name, superuser=False, person=""):
+    make = get_user_model().objects.create_superuser if superuser else get_user_model().objects.create_user
+    user = make(name, email=name, password="pw-for-tests")
+    client = Client()
+    client.login(username=name, password="pw-for-tests")
+    candidate = Candidate.for_user(user)
+    if person:
+        Candidate.objects.filter(pk=candidate.pk).update(name=person)
+        candidate.refresh_from_db()
+    return client, candidate
+
+
+@pytest.fixture
+def boss():
+    return sign_in("boss@x.test", superuser=True)[0]
+
+
+@pytest.fixture
+def marie():
+    return sign_in("marie@x.test", person="Marie Dupont")[1]
+
+
+def chat(candidate, kind="idea", answers=None, completed=True, context=None, state="new", **extra):
+    answers = {"want": "Remind me the day before an interview", "value": "daily", "today": {"quick": "nothing"}, "often": "weekly", "more": "Merci"} if answers is None else answers
+    return Feedback.objects.create(candidate=candidate, kind=kind, answers=answers, completed=completed, state=state,
+                                   context=context or {"page": "pipeline", "object_id": None, "device": "phone", "mode": "standard", "language": "fr"}, **extra)
+
+
+def text_of(response) -> str:
+    return re.sub(r"\s+", " ", html_lib.unescape(re.sub(r"<[^>]+>", " ", response.content.decode()))).strip()
+
+
+def test_only_the_operator_reaches_the_page(marie):
+    item = chat(marie)
+    person, _ = sign_in("paul@x.test")
+    assert person.get(PAGE).status_code == 404 and person.post(STATE.format(item.pk), {"state": "read"}).status_code == 404
+    assert Client().get(PAGE).status_code == 302
+    item.refresh_from_db()
+    assert item.state == "new"
+
+
+def test_the_list_shows_who_when_where_and_every_answer_newest_first(boss, marie):
+    chat(marie, answers={"want": "An older idea"}, completed=False)
+    chat(marie, kind="problem", answers={"what": "Save did nothing", "where": "elsewhere", "where_detail": "the CV page", "impact": "small", "repeat": None},
+         context={"page": "settings", "object_id": None, "device": "desktop", "mode": "standard", "language": "en"})
+    page = text_of(boss.get(PAGE))
+    assert page.index("Save did nothing") < page.index("An older idea")  # newest first
+    assert f"C-{marie.pk:02d} (Marie)" in page and "marie@x.test" not in page.split("Copy as intent draft")[0]  # no address in the list
+    assert "on Settings" in page and "desktop" in page and "Somewhere else: the CV page" in page and "A small annoyance" in page and "(skipped)" in page
+    assert "unfinished" in page and page.count("unfinished") == 1
+    assert "2 in all" in page and "2 new" in page
+
+
+def test_the_questions_read_in_english_whatever_the_operators_language(boss, marie):
+    chat(marie)
+    with translation.override("fr"):
+        page = text_of(boss.get(PAGE, HTTP_ACCEPT_LANGUAGE="fr"))
+    assert "What would you like to be able to do?" in page and "Nothing, I just can't" in page
+
+
+def test_what_a_person_wrote_is_shown_escaped(boss, marie):
+    chat(marie, answers={"want": "<script>alert(1)</script>"}, completed=False)
+    html = boss.get(PAGE).content.decode()
+    assert "<script>alert(1)</script>" not in html and "&lt;script&gt;alert(1)&lt;/script&gt;" in html
+
+
+def test_a_job_the_page_was_about_is_named(boss, marie):
+    job = make_job(candidate=marie, canonical_key="k9", title="Head of Operations", company="Acme").job
+    chat(marie, context={"page": "job", "object_id": job.pk, "device": "phone", "mode": "standard", "language": "fr"})
+    assert "on A job (Head of Operations · Acme)" in text_of(boss.get(PAGE))
+
+
+def test_the_filters_by_kind_and_by_state(boss, marie):
+    chat(marie, answers={"want": "IDEA-TEXT"})
+    chat(marie, kind="problem", answers={"what": "PROBLEM-TEXT"}, state="read")
+    chat(marie, kind="opinion", answers={"about": "inbox", "change": "OPINION-TEXT"}, state="cycle", cycle_ref="016")
+    both = text_of(boss.get(PAGE))
+    assert all(word in both for word in ("IDEA-TEXT", "PROBLEM-TEXT", "OPINION-TEXT"))
+    assert "PROBLEM-TEXT" in text_of(boss.get(PAGE, {"kind": "problem"})) and "IDEA-TEXT" not in text_of(boss.get(PAGE, {"kind": "problem"}))
+    assert "OPINION-TEXT" in text_of(boss.get(PAGE, {"state": "cycle"})) and "IDEA-TEXT" not in text_of(boss.get(PAGE, {"state": "cycle"}))
+    assert "Nothing matches these filters." in text_of(boss.get(PAGE, {"kind": "idea", "state": "read"}))
+    assert "IDEA-TEXT" in text_of(boss.get(PAGE, {"kind": "bogus", "state": "bogus"}))  # unknown filter values are ignored
+
+
+def test_a_state_is_saved_and_the_cycle_is_kept_only_with_it(boss, marie):
+    item = chat(marie)
+    response = boss.post(STATE.format(item.pk), {"state": "cycle", "cycle_ref": " 016 feedback chat ", "back": "/ops/feedback/?kind=idea#fb-1"})
+    assert response.status_code == 302 and response.url == "/ops/feedback/?kind=idea#fb-1"
+    item.refresh_from_db()
+    assert item.state == "cycle" and item.cycle_ref == "016 feedback chat"
+    boss.post(STATE.format(item.pk), {"state": "read", "cycle_ref": "016"})
+    item.refresh_from_db()
+    assert item.state == "read" and item.cycle_ref == ""
+    boss.post(STATE.format(item.pk), {"state": "burnt"})  # not a state: nothing changes
+    item.refresh_from_db()
+    assert item.state == "read"
+    assert boss.get(STATE.format(item.pk)).status_code == 405
+
+
+def test_the_state_form_cannot_send_the_operator_to_another_site(boss, marie):
+    item = chat(marie)
+    for back in ("https://evil.example/x", "//evil.example/x", "/ops/feedback//evil.example", "/other/"):
+        response = boss.post(STATE.format(item.pk), {"state": "read", "back": back})
+        assert response.url in ("/ops/feedback/", "/ops/feedback//evil.example") and not response.url.startswith(("http", "//")), back
+
+
+def test_the_nav_counts_what_is_new_on_console_pages_only(boss, marie):
+    chat(marie)
+    other = chat(marie, kind="problem", answers={"what": "x"})
+    for path in ("/ops/", "/ops/people/", PAGE):
+        assert re.search(r">Feedback <span class=\"tag\"[^>]*>2</span>", boss.get(path).content.decode()), path
+    boss.post(STATE.format(other.pk), {"state": "read"})
+    assert re.search(r">Feedback <span class=\"tag\"[^>]*>1</span>", boss.get(PAGE).content.decode())
+    Feedback.objects.update(state="read")
+    html = boss.get(PAGE).content.decode()
+    assert ">Feedback</a>" in html and 'class="tag" style="color:var(--warn);border-color:var(--warn)">1' not in html
+    assert "Feedback" not in boss.get("/").content.decode().split("<main")[0].replace("Give feedback", "")  # the candidate app's pages do not carry it
+
+
+def test_the_page_costs_the_same_queries_for_three_items_or_thirty(boss, marie):
+    for i in range(3):
+        chat(marie, answers={"want": f"idea {i}"})
+    with CaptureQueriesContext(connection) as few:
+        boss.get(PAGE)
+    for i in range(27):
+        chat(marie, answers={"want": f"more {i}"})
+    with CaptureQueriesContext(connection) as many:
+        boss.get(PAGE)
+    assert len(many) == len(few)
+
+
+# ---------------------------------------------------------------- the intent draft
+
+TEMPLATE = pathlib.Path(__file__).resolve().parent.parent / "docs" / "sdlc" / "templates" / "intent.md"
+
+
+def headings(text):
+    return re.findall(r"^## .*$", text, flags=re.M)
+
+
+def test_the_draft_has_the_headings_of_the_intent_template_in_order(marie):
+    draft = feedback.intent_draft(chat(marie))
+    assert headings(draft) == headings(TEMPLATE.read_text(encoding="utf-8"))
+    assert draft.startswith("# Intent: Remind me the day before an interview\n") and "| **Cycle** | NNN |" in draft and "| **Owner** | Vlad |" in draft
+    assert draft.rstrip().endswith("- [ ] Goal and success measure confirmed by the owner")
+
+
+def test_the_draft_carries_their_words_the_usefulness_and_the_workaround(marie):
+    item = chat(marie, answers={"want": "Remind me\nthe day before", "value": "vital", "today": "I keep a spreadsheet", "often": "daily", "more": None})
+    draft = feedback.intent_draft(item)
+    assert "## The request, in your words\n> Remind me\n> the day before\n" in draft  # verbatim, line by line
+    assert "## Why now / the pain\n- What do you do today instead? I keep a spreadsheet\n" in draft
+    assert "- How useful would that be to you? I can't do without it" in draft and "- How often would you need it? Every day" in draft
+    assert "Anything else" not in draft  # a skipped answer is left out
+    assert f"Feedback #{item.pk}: an idea from C-{marie.pk:02d} (Marie)" in draft and "on Pipeline, phone, standard mode, language fr" in draft
+
+
+def test_the_draft_never_carries_an_address_or_the_operators_language(marie):
+    anonymous = Candidate.objects.create(name="paul@x.test")
+    item = chat(anonymous)
+    with translation.override("fr"):
+        draft = feedback.intent_draft(item)
+    assert "paul@x.test" not in draft and f"C-{anonymous.pk:02d}" in draft and f"C-{anonymous.pk:02d} (" not in draft
+    assert "What do you do today instead? Nothing, I just can't" in draft  # English, whatever the language of the operator
+
+
+def test_a_problem_and_an_opinion_make_a_draft_too_and_an_unfinished_one_says_so(marie):
+    problem = chat(marie, kind="problem", answers={"what": "Save did nothing", "where": "page", "impact": "slows", "repeat": "always"})
+    draft = feedback.intent_draft(problem)
+    assert "> Save did nothing" in draft and "- How much did it get in your way? It slows me down" in draft and "- Does it happen every time? Every time" in draft
+    opinion = chat(marie, kind="opinion", answers={"about": "ai", "value": "very", "good": "Fast", "change": None}, completed=False)
+    draft = feedback.intent_draft(opinion)
+    assert "> Fast" in draft and "The chat was not finished" in draft and "- What is it about? The AI review" in draft
+    choices_only = chat(marie, kind="opinion", answers={"about": "inbox", "value": "none"}, completed=False)
+    draft = feedback.intent_draft(choices_only)
+    assert "(no free text: see the answers below)" in draft and draft.startswith(f"# Intent: feedback {choices_only.pk}\n")
+
+
+def test_the_page_offers_the_draft_and_a_copy_button(boss, marie):
+    item = chat(marie)
+    html = boss.get(PAGE).content.decode()
+    assert f'id="draft-{item.pk}"' in html and f'data-copy="draft-{item.pk}"' in html and "# Intent: Remind me the day before an interview" in html
