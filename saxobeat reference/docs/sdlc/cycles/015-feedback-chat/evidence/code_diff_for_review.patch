+{% extends "jobs/ops/base.html" %}
+{% block title %}Feedback · Saxobeat{% endblock %}
+{% block content %}
+<h1>Feedback</h1>
+<p class="muted small" style="margin-top:-6px">What people told you through the chat in the corner of the app. Each item can be copied as the start of an intent file.</p>
+<div class="card small">
+  <strong>{{ total }}</strong> in all · <span style="color:var(--warn)">{{ totals.new|default:0 }} new</span> · {{ totals.read|default:0 }} read · {{ totals.cycle|default:0 }} turned into a cycle
+</div>
+<form method="get" class="row" style="gap:8px;margin:10px 0">
+  <select name="kind" style="width:auto"><option value="">All kinds</option><option value="idea" {% if kind == "idea" %}selected{% endif %}>Ideas</option><option value="problem" {% if kind == "problem" %}selected{% endif %}>Problems</option><option value="opinion" {% if kind == "opinion" %}selected{% endif %}>Opinions</option></select>
+  <select name="state" style="width:auto"><option value="">All states</option><option value="new" {% if state == "new" %}selected{% endif %}>New</option><option value="read" {% if state == "read" %}selected{% endif %}>Read</option><option value="cycle" {% if state == "cycle" %}selected{% endif %}>Turned into a cycle</option></select>
+  <button>Show</button>
+</form>
+{% if shown >= limit %}<p class="small muted">Showing the newest {{ limit }}.</p>{% endif %}
+{% for r in rows %}
+<div class="card" id="fb-{{ r.chat.pk }}">
+  <div class="row" style="justify-content:space-between;gap:12px;flex-wrap:wrap">
+    <div>
+      <span class="tag">{{ r.kind_label }}</span>
+      <strong>{{ r.who }}</strong>
+      <span class="small muted">· {{ r.chat.candidate.mode }} mode · {{ r.chat.created_at|date:"j M Y H:i" }}{% if r.page %} · on {{ r.page }}{% endif %}{% if r.job %} ({{ r.job }}){% elif r.chat.context.object_id %} (#{{ r.chat.context.object_id }}){% endif %}{% if r.chat.context.device %} · {{ r.chat.context.device }}{% endif %}</span>
+      {% if not r.chat.completed %}<span class="tag" style="color:var(--warn);border-color:var(--warn)">unfinished</span>{% endif %}
+    </div>
+    <form method="post" action="{% url 'ops_feedback_state' r.chat.pk %}" class="row" style="gap:6px;margin:0">{% csrf_token %}
+      <input type="hidden" name="back" value="{{ back }}#fb-{{ r.chat.pk }}">
+      <select name="state" style="width:auto">
+        <option value="new" {% if r.chat.state == "new" %}selected{% endif %}>New</option>
+        <option value="read" {% if r.chat.state == "read" %}selected{% endif %}>Read</option>
+        <option value="cycle" {% if r.chat.state == "cycle" %}selected{% endif %}>Turned into a cycle</option>
+      </select>
+      <input type="text" name="cycle_ref" value="{{ r.chat.cycle_ref }}" placeholder="cycle, e.g. 016" maxlength="40" style="width:130px" aria-label="Cycle it became">
+      <button class="small">Save</button>
+    </form>
+  </div>
+  <div style="margin-top:10px">
+    {% for question, answer in r.pairs %}
+    <div class="small muted" style="margin-top:6px">{{ question }}</div>
+    <div style="white-space:pre-wrap;overflow-wrap:anywhere">{{ answer }}</div>
+    {% endfor %}
+  </div>
+  <details class="fold" style="margin-top:12px">
+    <summary class="small">Copy as intent draft</summary>
+    <textarea id="draft-{{ r.chat.pk }}" readonly rows="14" style="width:100%;margin:8px 0;font-family:ui-monospace,Consolas,monospace;font-size:12px">{{ r.draft }}</textarea>
+    <button type="button" data-copy="draft-{{ r.chat.pk }}" class="primary">Copy as intent draft</button>
+  </details>
+</div>
+{% empty %}
+<div class="card muted">{% if kind or state %}Nothing matches these filters.{% else %}Nothing yet. People see a round button at the bottom right of the app; what they tell you arrives here.{% endif %}</div>
+{% endfor %}
+{% endblock %}
