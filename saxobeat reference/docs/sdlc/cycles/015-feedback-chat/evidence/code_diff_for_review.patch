+"""Cycle 015, slice 6: the chat in French. Every question, button and message a person sees has a French sentence, and the French shows in the sheet."""
+
+import html as html_lib
+import re
+
+import pytest
+from django.contrib.auth import get_user_model
+from django.test import Client
+from django.utils import translation
+
+from jobs import feedback
+from jobs.models import Candidate, Feedback
+
+pytestmark = pytest.mark.django_db
+
+FR = {"HTTP_ACCEPT_LANGUAGE": "fr"}
+
+
+def say(lang, lazy) -> str:
+    with translation.override(lang):
+        return str(lazy)
+
+
+@pytest.fixture
+def marie():
+    user = get_user_model().objects.create_user("marie@x.test", email="marie@x.test", password="pw-for-tests")
+    candidate = Candidate.for_user(user)
+    Candidate.objects.filter(pk=candidate.pk).update(language="fr")
+    client = Client()
+    client.login(username="marie@x.test", password="pw-for-tests")
+    return client
+
+
+def text_of(response) -> str:
+    return re.sub(r"\s+", " ", html_lib.unescape(re.sub(r"<[^>]+>", " ", response.content.decode()))).strip()
+
+
+def every_lazy_string():
+    """Every sentence the script can show a person."""
+    out = [label for _key, label in feedback.PATHS] + [label for label in feedback.PAGE_LABELS.values()]
+    for script in feedback.SCRIPT.values():
+        for step in script:
+            out.append(step.text)
+            out += [label for _key, label in step.choices] + list(step.details.values())
+            if step.quick:
+                out.append(step.quick[1])
+    return out
+
+
+def test_every_sentence_of_the_script_has_a_french_that_differs_from_the_english():
+    lazies = every_lazy_string()
+    assert len(lazies) > 60
+    same_in_french = {"Pipeline", "Contacts", "E-mails"}  # words the app's own French uses as they are
+    untranslated = [say("en", s) for s in lazies if say("fr", s) == say("en", s) and say("en", s) not in same_in_french]
+    assert untranslated == []
+
+
+def test_the_messages_of_the_chat_are_in_french_too():
+    for english in ("What would you like to tell me?", "Thank you, I read every one.", "(skipped)", "Skip", "Send", "Write here", "Close", "Tell me something else",
+                    "That is plenty for today, thank you. Come back tomorrow and tell me more.", "Please write a few words first.", "Please pick one of the buttons.",
+                    "Pick one of the three buttons.", "This chat is finished.", "That is not the current question."):
+        with translation.override("fr"):
+            from django.utils.translation import gettext
+
+            assert gettext(english) != english, english
+
+
+def test_each_path_shows_in_french_from_its_first_question_to_the_thanks(marie):
+    for kind, script in feedback.SCRIPT.items():
+        opened = text_of(marie.get("/feedback/", {"kind": kind, "page": "pipeline", "device": "phone"}, **FR))
+        assert say("fr", script[0].text) in opened and say("en", script[0].text) not in opened
+        chat = None
+        for index, step in enumerate(script):
+            value = step.choices[0][0] if step.kind == "choice" else "x"
+            response = marie.post("/feedback/answer/", {"kind": kind, "chat": chat.pk if chat else "", "key": step.key, "value": value, "page": "pipeline"}, **FR)
+            chat = Feedback.objects.get(candidate__user__username="marie@x.test", kind=kind) if chat is None else chat
+            page = text_of(response)
+            if index + 1 < len(script):
+                following = script[index + 1]
+                assert say("fr", following.text) in page, (kind, following.key)
+                assert say("en", following.text) not in page, (kind, following.key)
+                for _key, label in following.choices:
+                    assert say("fr", label) in page, (kind, following.key, say("en", label))
+            else:
+                assert "Merci, je lis tous les messages." in page and "Thank you" not in page
+        Feedback.objects.filter(candidate__user__username="marie@x.test").delete()
+
+
+def test_the_greeting_the_page_name_and_the_buttons_are_in_french(marie):
+    page = text_of(marie.get("/feedback/", {"path": "/pipeline/", "w": "390"}, **FR))
+    assert "Que voulez-vous me dire ?" in page and "Vous êtes sur « Pipeline »." in page
+    for _key, label in feedback.PATHS:
+        assert say("fr", label) in page
+    assert "What would you like to tell me" not in page
+
+
+def test_the_button_and_the_sheet_frame_are_in_french(marie):
+    html = marie.get("/", **FR).content.decode()
+    assert 'aria-label="Donner mon avis"' in html and "Dites-moi ce que vous pensez" in html and 'aria-label="Votre avis"' in html
+    assert "Give feedback" not in html and "Tell me what you think" not in html
