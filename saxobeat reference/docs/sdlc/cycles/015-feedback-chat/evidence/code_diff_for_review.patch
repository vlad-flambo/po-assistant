+"""Cycle 015, slice 3: the feedback chat's two endpoints for people (open, answer). See docs/sdlc/cycles/015-feedback-chat/spec.md."""
+
+import re
+
+import pytest
+from django.contrib.auth import get_user_model
+from django.test import Client
+
+from jobs import accounts, feedback
+from jobs.models import Candidate, Feedback, OutgoingEmail
+
+pytestmark = pytest.mark.django_db
+
+KINDS = [Feedback.IDEA, Feedback.PROBLEM, Feedback.OPINION]
+OPEN, ANSWER = "/feedback/", "/feedback/answer/"
+
+
+def sign_in(name="marie@x.test", superuser=False):
+    make = get_user_model().objects.create_superuser if superuser else get_user_model().objects.create_user
+    user = make(name, email=name, password="pw-for-tests")
+    client = Client()
+    client.login(username=name, password="pw-for-tests")
+    return client, Candidate.for_user(user)
+
+
+@pytest.fixture
+def me():
+    return sign_in()
+
+
+def say(client, **fields):
+    return client.post(ANSWER, {"page": "pipeline", "obj": "", "device": "phone", **fields})
+
+
+def text_of(response) -> str:
+    return re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", response.content.decode())).strip()
+
+
+def test_the_chat_needs_a_signed_in_person():
+    anonymous = Client()
+    assert anonymous.get(OPEN).status_code == 302 and "/login" in anonymous.get(OPEN).url
+    assert anonymous.post(ANSWER, {"kind": "idea", "key": "want", "value": "x"}).status_code == 302
+    assert Feedback.objects.count() == 0
+
+
+def test_opening_shows_the_three_buttons_names_the_page_and_writes_nothing(me):
+    client, _ = me
+    response = client.get(OPEN, {"path": "/pipeline/", "w": "390"})
+    assert response.status_code == 200
+    html = response.content.decode()
+    assert html.count('name="kind"') == 3 and all(f'value="{k}"' in html for k in KINDS)
+    assert "You are on “Pipeline”" in html and 'name="page" value="pipeline"' in html and 'name="device" value="phone"' in html
+    assert "tied to your account" in html
+    assert Feedback.objects.count() == 0
+
+
+def test_the_page_a_job_number_and_the_screen_are_read_from_where_it_was_opened(me):
+    client, _ = me
+    html = client.get(OPEN, {"path": "/job/17/", "w": "1280"}).content.decode()
+    assert 'name="page" value="job"' in html and 'name="obj" value="17"' in html and 'name="device" value="desktop"' in html
+    odd = client.get(OPEN, {"path": "//evil.example/x", "w": "wide"}).content.decode()
+    assert 'name="page" value=""' in odd and 'name="device" value=""' in odd and "You are on" not in odd
+
+
+def test_choosing_a_path_shows_its_first_question_and_still_writes_nothing(me):
+    client, _ = me
+    for kind, question in (("idea", "What would you like to be able to do?"), ("problem", "What happened, and what did you expect?"), ("opinion", "What is it about?")):
+        assert question in text_of(client.get(OPEN, {"kind": kind, "page": "inbox", "obj": "", "device": "phone"}))
+    assert "<textarea" in client.get(OPEN, {"kind": "idea"}).content.decode()
+    assert Feedback.objects.count() == 0
+    assert "What would you like to tell me?" in text_of(client.get(OPEN, {"kind": "complaint"}))  # an unknown path starts over
+
+
+def test_the_first_answer_makes_the_chat_and_returns_the_next_question(me):
+    client, candidate = me
+    response = say(client, kind="idea", key="want", value="Remind me before an interview", obj="17")
+    chat = Feedback.objects.get()
+    assert chat.candidate == candidate and chat.kind == "idea" and chat.answers == {"want": "Remind me before an interview"}
+    assert chat.context["page"] == "pipeline" and chat.context["object_id"] == 17 and chat.context["device"] == "phone" and chat.context["mode"] == candidate.mode
+    page = text_of(response)
+    assert "Remind me before an interview" in page and "How useful would that be to you?" in page
+    assert f'name="chat" value="{chat.pk}"' in response.content.decode()
+
+
+def test_a_whole_chat_by_the_endpoints_ends_with_thanks_and_sends_no_mail(me):
+    client, _ = me
+    say(client, kind="idea", key="want", value="Remind me")
+    chat = Feedback.objects.get()
+    for fields in ({"key": "value", "value": "daily"}, {"key": "today", "quick": "nothing"}, {"key": "often", "skip": "1"}):
+        say(client, chat=chat.pk, **fields)
+    last = say(client, chat=chat.pk, key="more", value="Merci")
+    chat.refresh_from_db()
+    assert chat.completed and Feedback.objects.count() == 1
+    assert chat.answers == {"want": "Remind me", "value": "daily", "today": {"quick": "nothing"}, "often": None, "more": "Merci"}
+    page = text_of(last)
+    assert "Thank you, I read every one." in page and "Tell me something else" in page
+    assert OutgoingEmail.objects.count() == 0
+
+
+def test_a_refused_answer_says_why_and_keeps_the_question(me):
+    client, _ = me
+    page = text_of(say(client, kind="idea", key="want", value="   "))
+    assert "Please write a few words first." in page and "What would you like to be able to do?" in page
+    assert "Please write a few words first." in text_of(say(client, kind="idea", key="want", skip="1"))  # the first question cannot be skipped
+    assert "under 2000 characters" in text_of(say(client, kind="idea", key="want", value="x" * 2001)).replace(",", "")
+    assert Feedback.objects.count() == 0
+    assert "Pick one of the three buttons." in text_of(say(client, kind="complaint", key="want", value="x"))
+    assert Feedback.objects.count() == 0
+
+
+def test_a_choice_that_asks_for_more_keeps_the_short_text(me):
+    client, _ = me
+    say(client, kind="problem", key="what", value="It broke")
+    chat = Feedback.objects.get()
+    page = say(client, chat=chat.pk, key="where", value="elsewhere", detail="The CV page")
+    chat.refresh_from_db()
+    assert chat.answers["where"] == "elsewhere" and chat.answers["where_detail"] == "The CV page"
+    assert "Somewhere else: The CV page" in text_of(page)
+
+
+def test_what_a_person_writes_is_shown_back_escaped(me):
+    client, _ = me
+    page = say(client, kind="idea", key="want", value="<script>alert(1)</script>").content.decode()
+    assert "<script>alert(1)</script>" not in page and "&lt;script&gt;" in page
+
+
+def test_nobody_reaches_someone_elses_chat(me):
+    client, _ = me
+    other_client, _ = sign_in("paul@x.test")
+    say(other_client, kind="idea", key="want", value="Paul's idea")
+    chat = Feedback.objects.get()
+    assert say(client, chat=chat.pk, key="value", value="daily").status_code == 404
+    assert say(client, chat="abc", key="value", value="daily").status_code == 404
+    assert say(client, chat="9999", key="value", value="daily").status_code == 404
+    assert Feedback.objects.get().answers == {"want": "Paul's idea"}
+
+
+def test_the_daily_limit_gives_a_friendly_stop_and_no_21st_row(me):
+    client, candidate = me
+    for i in range(feedback.MAX_CHATS_PER_DAY):
+        say(client, kind="idea", key="want", value=f"idea {i}")
+    page = text_of(say(client, kind="idea", key="want", value="one too many"))
+    assert "That is plenty for today" in page and "What would you like to be able to do?" not in page
+    assert Feedback.objects.filter(candidate=candidate).count() == feedback.MAX_CHATS_PER_DAY
+
+
+def test_nobody_sends_feedback_while_viewing_as_someone_else():
+    boss, _ = sign_in("boss@x.test", superuser=True)
+    _, marie = sign_in("marie2@x.test")
+    assert boss.post("/ops/people/", {"action": "view_as", "candidate": marie.pk}).url == "/"
+    assert boss.get(OPEN).status_code == 403
+    assert say(boss, kind="idea", key="want", value="in her name").status_code == 403
+    assert Feedback.objects.count() == 0
+    boss.post("/ops/view-as/stop/")
+    assert boss.get(OPEN).status_code == 200
+
+
+def test_the_endpoints_take_only_their_method_and_are_never_cached(me):
+    client, _ = me
+    assert client.post(OPEN).status_code == 405 and client.get(ANSWER).status_code == 405
+    for response in (client.get(OPEN), say(client, kind="idea", key="want", value="x")):
+        assert "no-store" in response["Cache-Control"] or "private" in response["Cache-Control"]
+
+
+def test_deleting_the_account_deletes_the_chats(me):
+    client, candidate = me
+    say(client, kind="idea", key="want", value="x")
+    other_client, _ = sign_in("paul@x.test")
+    say(other_client, kind="idea", key="want", value="y")
+    accounts.delete_account(candidate.user)
+    assert list(Feedback.objects.values_list("answers", flat=True)) == [{"want": "y"}]
+
+
+# ---------------------------------------------------------------- the button in the page (slice 4)
+
+from tests.helpers import make_job  # noqa: E402
+
+
+def test_the_button_and_the_empty_sheet_are_on_every_signed_in_page(me):
+    client, candidate = me
+    job = make_job(candidate=candidate, canonical_key="k1", title="Head of Operations", company="Acme")
+    pages = ["/", "/archive/", "/pipeline/", f"/job/{job.job_id}/", "/interviews/", "/companies/", "/contacts/", "/insights/", "/settings/",
+             "/more/", "/cv/", "/suggest/", f"/job/{job.job_id}/followup/", f"/job/{job.job_id}/packet/"]
+    seen = []
+    for path in pages:
+        response = client.get(path, follow=True)
+        assert response.status_code == 200, path
+        html = response.content.decode()
+        assert 'class="fb-fab' in html and 'id="feedback-sheet"' in html and 'id="feedback-body"' in html, path
+        assert 'hx-get="/feedback/"' in html and "Give feedback" in html, path
+        seen.append(path)
+    assert len(seen) == len(pages)
+
+
+def test_the_button_is_not_on_pages_without_a_person_the_console_or_while_viewing_as():
+    anonymous = Client()
+    for path in ("/login/", "/password/forgot/", "/reset/done/", "/join/not-a-real-link/"):
+        html = anonymous.get(path).content.decode()
+        assert 'class="fb-fab' not in html and 'id="feedback-sheet"' not in html, path
+    boss, _ = sign_in("boss@x.test", superuser=True)
+    assert 'class="fb-fab' in boss.get("/").content.decode()  # the operator's own candidate app has it
+    for path in ("/ops/", "/ops/people/", "/ops/mail/"):
+        assert 'class="fb-fab' not in boss.get(path).content.decode(), path  # the console is not the candidate's app
+    _, marie = sign_in("marie3@x.test")
+    boss.post("/ops/people/", {"action": "view_as", "candidate": marie.pk})
+    assert 'class="fb-fab' not in boss.get("/").content.decode()
