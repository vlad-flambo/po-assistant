+"""The feedback chat's two endpoints for people (docs/sdlc/cycles/015-feedback-chat/spec.md): open it (nothing is written) and answer a question
+(saved at once). Both answer with the sheet's content as an HTMX fragment. Refused while the operator views the app as a candidate: feedback is
+the person's own words, never the operator's in their name."""
+
+from __future__ import annotations
+
+from django.contrib.auth.decorators import login_required
+from django.http import Http404, HttpResponse
+from django.db.models import Count
+from django.shortcuts import get_object_or_404, redirect, render
+from django.utils import translation
+from django.views.decorators.cache import never_cache
+from django.views.decorators.http import require_GET, require_POST
+
+from . import feedback, impersonation
+from .access import operator_required
+from .models import Feedback, Job
+
+
+def _where(data) -> dict:
+    """What the sheet knows about the page the person was on: from the path it was opened on (first time), or carried in the form (after)."""
+    if "path" in data:
+        page, number = feedback.page_of(data.get("path", ""))
+        device = feedback.device_of(data.get("w"))
+    else:
+        page, number, device = (data.get("page") or "")[:60], data.get("obj") or "", data.get("device") or ""
+    return {"page": page, "obj": number if number is not None else "", "device": device if device in feedback.DEVICES else ""}
+
+
+def _sheet(request, where: dict, *, kind: str = "", chat: Feedback | None = None, error: str = "", limit: bool = False):
+    kind = chat.kind if chat else kind
+    step = None
+    if not limit and kind in feedback.SCRIPT:
+        step = feedback.next_step(kind, chat.answers) if chat else feedback.steps(kind)[0]
+    return render(request, "jobs/_feedback_sheet.html", {
+        "where": where, "page_label": feedback.PAGE_LABELS.get(where["page"]), "kind": kind if kind in feedback.SCRIPT else "",
+        "kind_label": dict(feedback.PATHS).get(kind), "paths": feedback.PATHS, "chat": chat, "step": step, "done": bool(chat and chat.completed),
+        "pairs": feedback.describe(chat) if chat else [], "error": error, "limit": limit, "max_text": feedback.MAX_TEXT, "max_detail": feedback.MAX_DETAIL,
+    })
+
+
+@login_required
+@never_cache
+@require_GET
+def open_chat(request):
+    """The sheet's content: the greeting and the three buttons, or (with `kind`) the first question of that path. Writes nothing."""
+    if impersonation.viewing(request):
+        return HttpResponse(status=403)
+    return _sheet(request, _where(request.GET), kind=request.GET.get("kind", ""))
+
+
+@login_required
+@never_cache
+@require_POST
+def answer_chat(request):
+    """One answer. The first one makes the chat, the next ones update it; the reply is the conversation so far and the next question."""
+    if impersonation.viewing(request):
+        return HttpResponse(status=403)
+    post = request.POST
+    where = _where(post)
+    chat = None
+    if post.get("chat"):
+        try:
+            chat = get_object_or_404(Feedback, pk=int(post["chat"]), candidate=request.candidate)
+        except ValueError:
+            raise Http404 from None
+    kind = chat.kind if chat else post.get("kind", "")
+    skip = post.get("skip") == "1"
+    context = {"page": where["page"], "object_id": where["obj"], "device": where["device"], "language": translation.get_language() or ""}
+    try:
+        chat = feedback.answer(request.candidate, chat, kind, post.get("key", ""), "" if skip else post.get("value", ""), post.get("detail", ""),
+                               "" if skip else post.get("quick", ""), context=context)
+    except feedback.Invalid as problem:
+        return _sheet(request, where, kind=kind, chat=chat, error=str(problem))
+    except feedback.LimitReached:
+        return _sheet(request, where, kind=kind, limit=True)
+    return _sheet(request, where, chat=chat)
+
+
+# ---------------------------------------------------------------- the operator's page
+
+JOB_PAGES = ("job", "followup", "packet", "cv_match", "referral")  # pages whose object number is a job
+LIMIT = 200
+
+
+@operator_required
+def ops_list(request):
+    """Everything people told through the chat, newest first, with their answers and a draft of the intent file each could start."""
+    kind, state = request.GET.get("kind", ""), request.GET.get("state", "")
+    items = Feedback.objects.select_related("candidate")
+    if kind in feedback.SCRIPT:
+        items = items.filter(kind=kind)
+    if state in (Feedback.NEW, Feedback.READ, Feedback.CYCLE):
+        items = items.filter(state=state)
+    chats = list(items[:LIMIT])
+    job_ids = {c.context.get("object_id") for c in chats if c.context.get("page") in JOB_PAGES and c.context.get("object_id")}
+    titles = {j.pk: f"{j.title} · {j.company}" for j in Job.objects.filter(pk__in=job_ids).only("title", "company")} if job_ids else {}
+    rows = []
+    with translation.override("en"):  # the console is in English: the questions and choices are shown as written, whatever the operator's language
+        for chat in chats:
+            context = chat.context
+            rows.append({
+                "chat": chat, "who": feedback.who(chat.candidate), "pairs": feedback.describe(chat), "draft": feedback.intent_draft(chat),
+                "page": str(feedback.PAGE_LABELS.get(context.get("page"), "")) or context.get("page") or "",
+                "job": titles.get(context.get("object_id")) if context.get("page") in JOB_PAGES else "", "kind_label": str(dict(feedback.PATHS)[chat.kind]),
+            })
+    totals = {row["state"]: row["n"] for row in Feedback.objects.values("state").annotate(n=Count("id"))}
+    return render(request, "jobs/ops/feedback.html", {
+        "rows": rows, "kind": kind, "state": state, "totals": totals, "total": sum(totals.values()), "shown": len(rows), "limit": LIMIT,
+        "back": request.get_full_path(),
+    })
+
+
+@operator_required
+@require_POST
+def ops_set_state(request, pk: int):
+    chat = get_object_or_404(Feedback, pk=pk)
+    state = request.POST.get("state", "")
+    if state in (Feedback.NEW, Feedback.READ, Feedback.CYCLE):
+        chat.state = state
+        chat.cycle_ref = request.POST.get("cycle_ref", "").strip()[:40] if state == Feedback.CYCLE else ""
+        chat.save(update_fields=["state", "cycle_ref", "updated_at"])
+    back = request.POST.get("back", "")
+    return redirect(back if back.startswith("/ops/feedback/") and "//" not in back[:15] else "ops_feedback")
