  "initiatives": [
    {
      "id": "ini_conversion",
      "name": "O1 · Conversion Free → Plus",
      "description": "Faire passer la part d'abonnés Plus de 6 % à 9 % des candidats actifs d'ici fin juin 2027. Levier : la valeur perçue (analyse IA, relances, contacts) et un paywall compréhensible.",
      "target_date": "2027-06-30",
      "status": "active"
    },
    {
      "id": "ini_activation",
      "name": "O2 · Activation et rétention",
      "description": "70 % des nouveaux inscrits trient au moins 10 offres dans leurs 7 premiers jours ; onboarding terminé en moins de 4 minutes ; confiance dans le score (4 utilisateurs sur 5 le jugent clair).",
      "target_date": "2027-06-30",
      "status": "active"
    },
    {
      "id": "ini_b2b",
      "name": "O3 · Lancement de l'offre Business",
      "description": "Passer de 10 à 15 comptes Business payants (cabinets d'outplacement, écoles, coachs) et garder 100 % des comptes pilotes. Prérequis : console conseiller utilisable et reporting.",
      "target_date": "2027-06-30",
      "status": "active"
    }
  ],
  "projects": [
    {
      "id": "prj_score",
